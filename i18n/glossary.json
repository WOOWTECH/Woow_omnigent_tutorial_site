{
  "_readme": "Binding terminology for the international English Node-RED guide. Upstream product and UI wording takes precedence.",
  "version": 1,
  "principles": [
    "Use US English and sentence case.",
    "Preserve product names, node names, configuration keys, commands, file names, versions, and placeholders exactly.",
